{
  "name": "bil-sammenligning-server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=.env dist/server/src/index.js",
    "test": "vitest run",
    "generate:types": "node --env-file=.env scripts/generate-types.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "openapi-typescript": "^7.4.4",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^5.0.1"
  }
}
