PORT=3001

# Host for Statens vegvesen Autosys enkeltoppslag API.
# Endepunktet som brukes er GET {AUTOSYS_HOST}/enkeltoppslag/kjoretoydata?kjennemerke=...
AUTOSYS_HOST=https://akfell-datautlevering.atlas.vegvesen.no

# API-nøkkel fra bestillingsbekreftelsen din på vegvesen.no.
# Sendes som header: SVV-Authorization: Apikey <nøkkel>
AUTOSYS_API_KEY=your-api-key-here

# Origin som CORS skal tillate (klienten i dev-modus). Trengs ikke på Vercel,
# der client og server deler domene.
CLIENT_ORIGIN=http://localhost:5173

# Antall reverse proxy-hopp foran appen i produksjon (styrer hvordan
# express-rate-limit finner riktig klient-IP fra X-Forwarded-For).
# 1 = bak én proxy (typisk for Vercel/Render/Fly/Nginx). Sett til 0 hvis
# appen eksponeres direkte uten noen proxy foran seg.
TRUST_PROXY=1
