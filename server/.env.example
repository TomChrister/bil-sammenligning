PORT=3001

# Host for Statens vegvesen Autosys enkeltoppslag API.
# Endepunktet som brukes er GET {AUTOSYS_HOST}/enkeltoppslag/kjoretoydata?kjennemerke=...
AUTOSYS_HOST=https://akfell-datautlevering.atlas.vegvesen.no

# API-nøkkel fra bestillingsbekreftelsen din på vegvesen.no.
# Sendes som header: SVV-Authorization: Apikey <nøkkel>
AUTOSYS_API_KEY=your-api-key-here

# Origin som CORS skal tillate (klienten i dev-modus)
CLIENT_ORIGIN=http://localhost:5173
